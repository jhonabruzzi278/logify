worker_processes auto;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 10M;

  server {
    listen 8080;
    server_name _;

    location = /healthz {
      default_type application/json;
      return 200 '{"status":"UP","service":"logify-api-gateway"}';
    }

    location /api/auth {
      proxy_pass ${ORDERS_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/customers {
      proxy_pass ${ORDERS_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/settings {
      proxy_pass ${ORDERS_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/orders {
      proxy_pass ${ORDERS_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/inventory {
      proxy_pass ${INVENTORY_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/sales {
      proxy_pass ${INVENTORY_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/suppliers {
      proxy_pass ${INVENTORY_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/shipments {
      proxy_pass ${SHIPPING_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location /api/notifications {
      proxy_pass ${NOTIFICATION_SERVICE_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Tenant-Slug $http_x_tenant_slug;
    }

    location / {
      default_type application/json;
      return 404 '{"message":"Route not found"}';
    }
  }
}
