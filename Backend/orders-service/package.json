{
  "name": "orders-service",
  "version": "1.0.2",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "cd .. && node orders-service/node_modules/jest/bin/jest.js --config orders-service/package.json --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "rootDir": "..",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/orders-service/src",
      "<rootDir>/shared"
    ],
    "testMatch": [
      "**/orders-service/src/**/*.test.js"
    ],
    "modulePaths": [
      "<rootDir>/orders-service/node_modules"
    ],
    "moduleNameMapper": {
      "^\\.\\./shared/(.*)$": "<rootDir>/shared/$1"
    },
    "coverageDirectory": "<rootDir>/orders-service/coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "collectCoverageFrom": [
      "orders-service/src/**/*.js",
      "!orders-service/src/**/*.test.js",
      "shared/security.js"
    ]
  }
}
