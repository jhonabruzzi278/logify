# Variables de entorno por servicio en Render (plan gratuito).
# No es un .env que se carga automáticamente: es la referencia de lo que
# render.yaml ya declara. Los campos marcados aquí como "(pedido por Render)"
# tienen sync: false en render.yaml — Render te los pide al crear el Blueprint,
# no están en el repo.
#
# Base de datos: Neon (Postgres gestionado gratis, no lo gestiona Render).
# Ver RENDER_DEPLOY.md para crear el proyecto en Neon y las 4 bases de datos.
#
# Limitacion clave del plan free de Render: los servicios NO tienen red
# privada real entre si (un "web service" gratis no puede RECIBIR trafico
# interno). Por eso las URLs entre microservicios usan el dominio publico
# https://<servicio>.onrender.com de cada uno, no un hostname interno.
# Esas URLs solo existen DESPUES del primer deploy — ver la Parte A.2 de
# RENDER_DEPLOY.md para el proceso de dos pasadas.

# ============================================================
# orders-service
# ============================================================
PORT=8081
DB_URL=postgresql://usuario:password@ep-xxxx.neon.tech/orders_db?sslmode=require   # (pedido por Render)
INVENTORY_SERVICE_URL=https://inventory-service-xxxx.onrender.com   # URL real, disponible tras el primer deploy
SHIPPING_SERVICE_URL=https://shipping-service-xxxx.onrender.com     # URL real, disponible tras el primer deploy
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
APP_URL=https://tu-frontend.vercel.app
JWT_SECRET=__generar_valor_random_fuerte__   # (pedido por Render)
JWT_EXPIRES_IN=8h
SMTP_HOST=   # (pedido por Render)
SMTP_PORT=587
SMTP_USER=   # (pedido por Render)
SMTP_PASS=   # (pedido por Render)
SMTP_FROM=no-reply@logify.cl

# ============================================================
# inventory-service
# ============================================================
PORT=8082
DB_URL=postgresql://usuario:password@ep-xxxx.neon.tech/inventory_db?sslmode=require   # (pedido por Render)
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
JWT_SECRET=__mismo_valor_que_orders-service__   # (pedido por Render)
JWT_EXPIRES_IN=8h

# ============================================================
# shipping-service
# ============================================================
PORT=8084
DB_URL=postgresql://usuario:password@ep-xxxx.neon.tech/shipping_db?sslmode=require   # (pedido por Render)
NOTIFICATION_SERVICE_URL=https://notification-service-xxxx.onrender.com   # URL real, disponible tras el primer deploy
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
APP_URL=https://tu-frontend.vercel.app
JWT_SECRET=__mismo_valor_que_orders-service__   # (pedido por Render)
JWT_EXPIRES_IN=8h
SMTP_HOST=   # (pedido por Render)
SMTP_PORT=587
SMTP_USER=   # (pedido por Render)
SMTP_PASS=   # (pedido por Render)
SMTP_FROM=no-reply@logify.cl

# ============================================================
# notification-service
# ============================================================
PORT=8085
DB_URL=postgresql://usuario:password@ep-xxxx.neon.tech/notification_db?sslmode=require   # (pedido por Render)
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
JWT_SECRET=__mismo_valor_que_orders-service__   # (pedido por Render)
JWT_EXPIRES_IN=8h
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=   # (pedido por Render)
VAPID_SUBJECT=mailto:logistica@logify.cl

# ============================================================
# api-gateway (nginx)
# ============================================================
PORT=8080
ORDERS_SERVICE_URL=https://orders-service-xxxx.onrender.com             # URL real, disponible tras el primer deploy
INVENTORY_SERVICE_URL=https://inventory-service-xxxx.onrender.com       # URL real, disponible tras el primer deploy
SHIPPING_SERVICE_URL=https://shipping-service-xxxx.onrender.com         # URL real, disponible tras el primer deploy
NOTIFICATION_SERVICE_URL=https://notification-service-xxxx.onrender.com # URL real, disponible tras el primer deploy
