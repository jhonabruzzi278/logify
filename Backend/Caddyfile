	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy api-gateway:80

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Pagina publica de status (Uptime Kuma) — ver wiki/Monitoreo.md.
{$STATUS_DOMAIN} {
	reverse_proxy uptime-kuma:3001

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Entrada publica exclusiva para la API central de facturacion en sandbox.
# Caddy comparte con el gateway una red Docker dedicada; billing-service y su
# PostgreSQL permanecen en la red privada del compose sandbox.
api-sandbox.logify.cl {
	reverse_proxy billing-sandbox-gateway:80

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
