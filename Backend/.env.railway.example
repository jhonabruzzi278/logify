# Variables de entorno por servicio en Railway
# No es un .env que se carga automáticamente: es la referencia para configurar
# cada servicio en el dashboard de Railway (Settings → Variables).
# Los valores ${{...}} son "reference variables" de Railway: se resuelven solos
# cuando seleccionas la variable del otro servicio/plugin en el dashboard.

# ============================================================
# Plugin PostgreSQL (Railway) — una sola instancia para las 4 DB
# ============================================================
# Railway expone automáticamente en el plugin Postgres:
#   PGHOST, PGPORT, PGUSER, PGPASSWORD, DATABASE_URL
# Tras crear el plugin, conectarse una vez (Data tab o `railway connect postgres`)
# y correr Backend/init-db.sql para crear: orders_db, inventory_db, shipping_db,
# notification_db. Luego correr Backend/stored-procedures.sql y, si se desea
# data de prueba, Backend/seed.sql.

# ============================================================
# orders-service
#   Root Directory: Logify/Backend
#   Dockerfile Path: orders-service/Dockerfile
#   Target Port: 8081
# ============================================================
DB_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/orders_db
INVENTORY_SERVICE_URL=http://${{inventory-service.RAILWAY_PRIVATE_DOMAIN}}:8082
SHIPPING_SERVICE_URL=http://${{shipping-service.RAILWAY_PRIVATE_DOMAIN}}:8084
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
PORT=8081
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@logify.cl
APP_URL=https://tu-frontend.vercel.app
JWT_SECRET=__generar_valor_random_fuerte__
JWT_EXPIRES_IN=8h

# ============================================================
# inventory-service
#   Root Directory: Logify/Backend
#   Dockerfile Path: inventory-service/Dockerfile
#   Target Port: 8082
# ============================================================
DB_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/inventory_db
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
PORT=8082
JWT_SECRET=__mismo_valor_que_orders-service__
JWT_EXPIRES_IN=8h

# ============================================================
# shipping-service
#   Root Directory: Logify/Backend
#   Dockerfile Path: shipping-service/Dockerfile
#   Target Port: 8084
# ============================================================
DB_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/shipping_db
NOTIFICATION_SERVICE_URL=http://${{notification-service.RAILWAY_PRIVATE_DOMAIN}}:8085
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
PORT=8084
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@logify.cl
APP_URL=https://tu-frontend.vercel.app
JWT_SECRET=__mismo_valor_que_orders-service__
JWT_EXPIRES_IN=8h

# ============================================================
# notification-service
#   Root Directory: Logify/Backend
#   Dockerfile Path: notification-service/Dockerfile
#   Target Port: 8085
# ============================================================
DB_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/notification_db
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-landing.vercel.app
PORT=8085
JWT_SECRET=__mismo_valor_que_orders-service__
JWT_EXPIRES_IN=8h
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:logistica@logify.cl

# ============================================================
# api-gateway (nginx)
#   Root Directory: Logify/Backend/nginx
#   Dockerfile Path: Dockerfile.railway
#   Target Port: 8080  →  activar Networking público aquí
# ============================================================
ORDERS_SERVICE_URL=http://${{orders-service.RAILWAY_PRIVATE_DOMAIN}}:8081
INVENTORY_SERVICE_URL=http://${{inventory-service.RAILWAY_PRIVATE_DOMAIN}}:8082
SHIPPING_SERVICE_URL=http://${{shipping-service.RAILWAY_PRIVATE_DOMAIN}}:8084
NOTIFICATION_SERVICE_URL=http://${{notification-service.RAILWAY_PRIVATE_DOMAIN}}:8085
