# Logify Environment Configuration
# Copy this file to .env and fill in your values

# Database
# OBLIGATORIO — docker-compose falla si esto está vacío. Generar con:
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DB_POOL_MAX=5

# Password del rol Postgres restringido "app_runtime" (sin BYPASSRLS), que
# orders-service usa para las queries de request bajo Row Level Security
# (ver Backend/shared/rls.js y wiki/Seguridad-y-RLS.md). El rol se crea solo
# al arrancar orders-service; el servicio se conecta con DB_URL (postgres,
# superusuario) unicamente para migraciones.
# OBLIGATORIO — docker-compose falla si esto está vacío. Generar con:
#   openssl rand -base64 32 | tr -d '/+='
DB_RUNTIME_PASSWORD=

# Inter-service URLs
INVENTORY_SERVICE_URL=http://inventory-service:8082
SHIPPING_SERVICE_URL=http://shipping-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085

# Email (SMTP) — optional; leave blank for demo mode (emails logged to console)
# Recomendado: Resend (resend.com) via su relay SMTP — capa gratis 3000/mes,
# no necesita buzón real en logify.cl, solo verificar el dominio por DNS.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<tu API key de Resend>
#   SMTP_FROM=Logify <no-reply@logify.cl>
# Mientras el dominio no esté verificado en Resend, podés probar con
# SMTP_FROM=onboarding@resend.dev (sin verificación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@logify.cl
# A dónde llegan las respuestas de los clientes a los correos automáticos
# (mientras no haya un correo propio de logify.cl atendido por alguien)
SMTP_REPLY_TO=jonathanguerra278@gmail.com

# Application URL (used in email links, e.g. invitaciones de usuario)
# En producción DEBE apuntar al dashboard SPA (app.logify.cl), NO a logify.cl
# (ese dominio sirve la Landing en Vercel y no tiene rutas de la app).
APP_URL=http://localhost:3000
# APP_URL=https://app.logify.cl

# Botón de soporte por WhatsApp (welcome email + dashboard del tenant)
SUPPORT_WHATSAPP_URL=https://wa.me/56938980598

# JWT Authentication
# OBLIGATORIO — docker-compose falla si esto está vacío. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Opcional — solo durante una rotación de JWT_SECRET (ver wiki/Rotacion-JWT.md):
# poné acá el secreto viejo, poné uno nuevo en JWT_SECRET, hacé rolling restart
# de los 4 servicios, esperá JWT_EXPIRES_IN y volvé a dejar esto vacío.
JWT_SECRET_PREVIOUS=

# Web Push (VAPID) — genera el tuyo con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:logistica@logify.cl

# Service config
SERVICE_NAME=logify
LOG_LEVEL=info
# En producción: dominios exactos separados por coma, nunca "*"
# (dominios reales de logify.cl: landing + www en Vercel, dashboard en app.logify.cl)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5173
# ALLOWED_ORIGINS=https://logify.cl,https://www.logify.cl,https://app.logify.cl,https://gestion.logify.cl
RATE_LIMIT_MAX=200

# Signup self-service (Fase 4E, ver wiki/Multi-Tenant.md) — orders-service
# Secreto compartido para POST/GET /api/admin/coupons (gestión de cupones de
# bienvenida). Sin esto, esos endpoints responden 503. Generar con:
#   openssl rand -base64 32 | tr -d '/+='
PLATFORM_ADMIN_KEY=
# IDs de usuario Clerk autorizados a entrar a https://gestion.logify.cl.
# Lista separada por comas; nunca usar emails ni roles de una organización.
PLATFORM_ADMIN_CLERK_USER_IDS=
BILLING_DEFAULT_PROVIDER=none
FLOW_API_KEY=
FLOW_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Máximo de registros por IP cada 15 min en POST /api/signup
SIGNUP_RATE_LIMIT_MAX=5
# Habilita el onboarding central. En producción el workflow lo sincroniza
# explícitamente para evitar que un valor legado del VPS cierre el registro.
SIGNUP_ENABLED=true

# Solo para despliegue en VPS con docker-compose.prod.yml (ver wiki/Despliegue-VPS.md)
# API_DOMAIN=api.logify.cl
# STATUS_DOMAIN=status.logify.cl
# ACME_EMAIL=tu-correo@logify.cl
