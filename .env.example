# Logify Environment Configuration
# Copy this file to .env and fill in your values

# Database
# OBLIGATORIO — docker-compose falla si esto está vacío. Generar con:
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DB_POOL_MAX=5

# Inter-service URLs
INVENTORY_SERVICE_URL=http://inventory-service:8082
SHIPPING_SERVICE_URL=http://shipping-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085

# Email (SMTP) — optional; leave blank for demo mode (emails logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@logify.cl

# Application URL (used in email links)
APP_URL=http://localhost:3000

# JWT Authentication
# OBLIGATORIO — docker-compose falla si esto está vacío. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Web Push (VAPID) — genera el tuyo con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:logistica@logify.cl

# Service config
SERVICE_NAME=logify
LOG_LEVEL=info
# En producción: dominios exactos separados por coma, nunca "*"
# (dominios reales de logify.cl: landing + www en Vercel, dashboard en app.logify.cl)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5173
# ALLOWED_ORIGINS=https://logify.cl,https://www.logify.cl,https://app.logify.cl
RATE_LIMIT_MAX=200

# Solo para despliegue en VPS con docker-compose.prod.yml (ver wiki/Despliegue-VPS.md)
# API_DOMAIN=api.logify.cl
# ACME_EMAIL=tu-correo@logify.cl
